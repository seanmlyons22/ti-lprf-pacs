{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "probe-rs-debug",
        "request": "launch",
        "name": "probe_rs Executable launch example",
        "speed": 55000,
        "cwd": "${workspaceFolder}",
        "chip": "CC2340R5",
        "wireProtocol": "Swd",
        "flashingConfig": {
          "flashingEnabled": true,
        },
        "coreConfigs": [
          {
            "coreIndex": 0,
            "programBinary": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cc23x0r5",
            "svdFile": "${workspaceFolder}/svds/cc23x0r5.svd",
          }
        ],
      }
    ]
  }